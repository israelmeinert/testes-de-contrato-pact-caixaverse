<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>br.com.horacerta</groupId>
  <artifactId>apuracao-horas</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.version>3.40.1.2</quarkus.version>
    <verifier.test>**/ApuracaoProviderContractTest.java</verifier.test>
    <pact.verifier.publishResults>false</pact.verifier.publishResults>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm-panache</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-h2</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkiverse.pact</groupId>
      <artifactId>quarkus-pact-provider</artifactId>
      <version>1.6.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals><goal>build</goal><goal>generate-code</goal><goal>generate-code-tests</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration><parameters>true</parameters></configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <failIfNoTests>true</failIfNoTests>
          <enablePropertiesElement>false</enablePropertiesElement>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <pact_do_not_track>true</pact_do_not_track>
            <junit.jupiter.execution.parallel.enabled>false</junit.jupiter.execution.parallel.enabled>
          </systemPropertyVariables>
          <includes>
            <include>**/*FuncionalTest.java</include>
            <include>**/*CalculoTest.java</include>
            <include>${verifier.test}</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>pact-broker</id>
      <properties>
        <verifier.test>**/ApuracaoBrokerContractTest.java</verifier.test>
      </properties>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <pactbroker.url>${env.PACT_BROKER_BASE_URL}</pactbroker.url>
                <pactbroker.auth.username>${env.PACT_BROKER_USERNAME}</pactbroker.auth.username>
                <pactbroker.auth.password>${env.PACT_BROKER_PASSWORD}</pactbroker.auth.password>
                <pact.provider.version>${pact.provider.version}</pact.provider.version>
                <pact.provider.branch>${pact.provider.branch}</pact.provider.branch>
                <pactbroker.providerBranch>${pactbroker.providerBranch}</pactbroker.providerBranch>
                <pact.verifier.publishResults>${pact.verifier.publishResults}</pact.verifier.publishResults>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>pact-webhook</id>
      <properties>
        <verifier.test>**/ApuracaoWebhookContractTest.java</verifier.test>
      </properties>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <pactbroker.url>${env.PACT_BROKER_BASE_URL}</pactbroker.url>
                <pactbroker.auth.username>${env.PACT_BROKER_USERNAME}</pactbroker.auth.username>
                <pactbroker.auth.password>${env.PACT_BROKER_PASSWORD}</pactbroker.auth.password>
                <pact.provider.version>${pact.provider.version}</pact.provider.version>
                <pact.provider.branch>${pact.provider.branch}</pact.provider.branch>
                <pactbroker.providerBranch>${pactbroker.providerBranch}</pactbroker.providerBranch>
                <pact.verifier.publishResults>${pact.verifier.publishResults}</pact.verifier.publishResults>
                <pact.filter.pacturl>${env.PACT_WEBHOOK_URL}</pact.filter.pacturl>
                <pact.filter.consumers>${env.PACT_WEBHOOK_CONSUMER}</pact.filter.consumers>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
